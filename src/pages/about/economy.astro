---
import SubpageLayout from '../../layouts/SubpageLayout.astro';
import economyData from '../../data/economy.json';
---

<SubpageLayout
  title={economyData.title}
  description={economyData.subtitle}
  sectionEmoji="📈"
  sectionLabel="Economic Overview"
  includeTopBar={true}
  includeFooter={true}
>

  <img src="/assets/images/nauru_economy_00001_.png" alt="Phosphate mining landscape on Nauru" class="hero-image" style="width:100%;border-radius:8px;margin-bottom:2rem">
  <p>{economyData.intro}</p>

  {economyData.sections.map(section => (
    <>
      <h2>{section.heading}</h2>
      {section.content.split('\n\n').map(para => (
        para.trim() ? <p>{para}</p> : null
      ))}
    </>
  ))}


  <h2>Next steps</h2>
  <div class="utility-grid">
    <a href="/visit/" class="utility-card"><h3>Plan a visit</h3><p>Turn context into a practical trip plan.</p></a>
    <a href="/directory/" class="utility-card"><h3>Open the directory</h3><p>Find the key contacts and services.</p></a>
    <a href="/news/" class="utility-card"><h3>Read updates</h3><p>See current news and story context.</p></a>
    <a href="/search/" class="utility-card"><h3>Search the site</h3><p>Jump to a specific fact or page.</p></a>
  </div>
</SubpageLayout>


<style>
  .utility-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:1rem 0 2rem}
  .utility-card{border:2px solid #1a1a2e;background:#fff;padding:18px;box-shadow:4px 4px 0 #1a1a2e;display:block}
  .utility-card h3{margin:0 0 8px;font-family:'Space Grotesk',sans-serif;color:#002B7F}
  @media (max-width: 720px){.utility-grid{grid-template-columns:1fr}}
</style>
