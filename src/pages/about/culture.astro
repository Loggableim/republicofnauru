<SubpageLayout
  title="Culture & Heritage"
  description="The soul of Nauru lives in its dance, music, food, festivals, craftsmanship, and the unbreakable bonds of community — a vibrant Pacific identity spanning three millennia."
  sectionEmoji="🎭"
  sectionLabel="People & Traditions"
  includeTopBar={true}
