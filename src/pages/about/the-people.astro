---
import SubpageLayout from '../../layouts/SubpageLayout.astro';
import peopleData from '../../data/the-people.json';
---

<SubpageLayout
  title={peopleData.title}
  description={peopleData.subtitle}
  sectionEmoji="👥"
  sectionLabel="Population & Identity"
  includeTopBar={true}
  includeFooter={true}
>
  <p>{peopleData.intro}</p>

  {peopleData.sections.map(section => (
    <>
      <h2>{section.heading}</h2>
      {section.content.split('\n\n').map(para => (
        para.trim() ? <p>{para}</p> : null
      ))}
    </>
  ))}

  <h2>Key Statistics</h2>
  <div class="fact-grid">
    {peopleData.statistics.map(stat => (
      <div class="fact">
        <div class="num">{stat.value}</div>
        <div class="label">{stat.label}</div>
      </div>
    ))}
  </div>

  <h2>Learn a Few Words of Nauruan</h2>
  <p>Here are some basic Nauruan phrases to try during your visit. Locals will appreciate the effort!</p>
  <ul>
    <li><strong>Ekamawir oma</strong> — Good morning</li>
    <li><strong>Ekamawir arön</strong> — Good afternoon/evening</li>
    <li><strong>Ña eko?</strong> — How are you?</li>
    <li><strong>Nab</strong> — Yes</li>
    <li><strong>Oe</strong> — No</li>
    <li><strong>IoỊy</strong> — Thank you</li>
  </ul>


  <h2>Next steps</h2>
  <div class="utility-grid">
    <a href="/visit/" class="utility-card"><h3>Plan a visit</h3><p>Turn context into a practical trip plan.</p></a>
    <a href="/directory/" class="utility-card"><h3>Open the directory</h3><p>Find the key contacts and services.</p></a>
    <a href="/news/" class="utility-card"><h3>Read updates</h3><p>See current news and story context.</p></a>
    <a href="/search/" class="utility-card"><h3>Search the site</h3><p>Jump to a specific fact or page.</p></a>
  </div>
</SubpageLayout>


<style>
  .utility-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:1rem 0 2rem}
  .utility-card{border:2px solid #1a1a2e;background:#fff;padding:18px;box-shadow:4px 4px 0 #1a1a2e;display:block}
  .utility-card h3{margin:0 0 8px;font-family:'Space Grotesk',sans-serif;color:#002B7F}
  @media (max-width: 720px){.utility-grid{grid-template-columns:1fr}}
</style>
