---
import SubpageLayout from '../../layouts/SubpageLayout.astro';
import servicesData from '../../data/services.json';
---

<SubpageLayout title="Services" description="Information and resources for citizens and visitors to the Republic of Nauru" sectionEmoji="🛠️" sectionLabel="Citizen & Visitor Services" includeTopBar={true} includeFooter={true}>
  <p>Nauru offers a range of government services for both citizens and visitors. Use the menu below to jump directly to the most requested topics.</p>

  <h2>Quick access</h2>
  <div class="service-grid">
    {servicesData.map(svc => (
      <a href={svc.href ?? '/contact/'} class="service-card">
        <h3>{svc.icon} {svc.title}</h3>
        <p>{svc.desc}</p>
        <span>Open info page →</span>
      </a>
    ))}
  </div>

  <h2>What to do next</h2>
  <div class="utility-grid">
    <a href="/directory/" class="utility-card"><h3>Directory</h3><p>Find the right office or emergency contact.</p></a>
    <a href="/visit/visa/" class="utility-card"><h3>Visa</h3><p>Travel entry and document guidance.</p></a>
    <a href="/visit/transport/" class="utility-card"><h3>Transport</h3><p>Arrival and local mobility information.</p></a>
    <a href="/news/" class="utility-card"><h3>News</h3><p>Current policy and service updates.</p></a>
  </div>

  <div class="info-box">
    <h4>🏛️ Government Information Office</h4>
    <p>The GIO is your first point of contact for many administrative inquiries. It publishes official announcements and can point you toward the correct department.</p>
  </div>

  <h2>Online Resources</h2>
  <ul>
    <li><strong>RONLAW:</strong> Nauru's legislation database at ronlaw.gov.nr</li>
    <li><strong>Nauru Bulletin:</strong> Official government newspaper</li>
    <li><strong>Radio Nauru:</strong> Live stream at radionauru.nr</li>
    <li><strong>Moodle:</strong> e-learning platform for students and educators</li>
  </ul>
</SubpageLayout>

<style>
  .service-grid,.utility-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:1rem 0 2rem}
  .service-card,.utility-card{border:2px solid #1a1a2e;background:#fff;padding:18px;box-shadow:4px 4px 0 #1a1a2e;display:block}
  .service-card h3,.utility-card h3{margin:0 0 8px;font-family:'Space Grotesk',sans-serif;color:#002B7F}
  .service-card p{margin:0 0 10px;line-height:1.7;color:#475569}
  .service-card span{font-size:12px;font-weight:700;color:#002B7F}
  @media (max-width: 720px){.service-grid,.utility-grid{grid-template-columns:1fr}}
</style>
