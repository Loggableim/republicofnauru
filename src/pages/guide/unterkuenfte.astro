    <!-- PREISE                                       -->
    <!-- ============================================ -->
    <h2>💰 Preisübersicht – Was die Unterkunft kostet</h2>

    <div class="fact-grid">
      <div class="fact">
        <div class="num">100–250 AUD</div>
        <div class="label">Menen Hotel – Nacht inkl. Frühstück</div>
      </div>
      <div class="fact">
        <div class="num">40–80 AUD</div>
