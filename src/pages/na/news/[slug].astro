---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TopBar from '../../../components/TopBar.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import newsData from '../../../data/news.json';

export function getStaticPaths() {
  return newsData.map(function(article) {
    return { params: { slug: article.id }, props: { article: article } };
  });
}

const { article } = Astro.props;
const breadcrumbPath = [
  { label: 'Edorer', url: '/na/news/' },
  { label: article.title, url: '/na/news/' + article.id + '/' },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.summary,
  url: new URL('/na/news/' + article.id + '/', 'https://republicofnauru.com').toString(),
  inLanguage: 'na',
  author: {
    '@type': 'Organization',
    name: 'Republic of Nauru (Independent Information Portal)',
    url: 'https://republicofnauru.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Republic of Nauru (Independent Information Portal)',
    url: 'https://republicofnauru.com',
  },
  datePublished: article.date ? new Date(article.date).toISOString() : undefined,
  dateModified: article.date ? new Date(article.date).toISOString() : undefined,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL('/na/news/' + article.id + '/', 'https://republicofnauru.com').toString(),
  },
};
---

<BaseLayout title={article.title + ' · Republik Naoero'} description={article.summary} locale="na">
  <Fragment slot="jsonld">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema, null, 2)} />
  </Fragment>
  <TopBar locale="na" />
  <div class="page-wrapper" id="main-content">
    <header class="article-header">
      <Breadcrumbs path={breadcrumbPath} />
      <a href="/na/news/" class="back-link">← Back to Edorer</a>
      <div class="article-meta">
        <span class="article-tag">{article.emoji} {article.tag}</span>
        <span class="article-date">{article.date}</span>
      </div>
      <h1>{article.title}</h1>
      <p class="article-summary">{article.summary}</p>
    </header>
    <main class="article-content">
      <article class="article-body">
        <p><strong>{article.title}</strong> matters because it touches one of the areas visitors and residents care about most: resilience, budgets, sustainability or tourism development.</p>
        <p>For visitors, the key question is simple: what changes on the ground, and what should you do with that information? Use this story as a planning cue, then follow the related links below.</p>
        <div class="info-box">
          <h4>💡 Why this matters</h4>
          <p>{article.summary} In practical terms, stories like this affect how you prepare, what you pack and how you plan your stay.</p>
        </div>
        <h2>What to read next</h2>
        <ul>
          <li><a href="/na/visit/">Visit guide</a> — core trip planning.</li>
          <li><a href="/na/about/">About Nauru</a> — context on history and culture.</li>
          <li><a href="/na/directory/">Directory</a> — essential contacts and resources.</li>
          <li><a href="/search/">Search</a> — jump to the exact topic you need.</li>
        </ul>
        <h2>Related practical questions</h2>
        <div class="related-grid">
          <a href="/na/visit/weather/">How does this affect travel timing?</a>
          <a href="/na/visit/visa/">Does this change entry planning?</a>
          <a href="/na/visit/accommodation/">Should I book earlier?</a>
          <a href="/na/visit/communications/">Will connectivity matter more?</a>
        </div>
      </article>
    </main>
  </div>
  <Footer />
</BaseLayout>

<style>
  .page-wrapper { min-height: 100vh; background: #faf8f0; }
  .article-header { background: linear-gradient(135deg, #FFC72C 0%, #FFE082 50%, #FFC72C 100%); padding: 60px 48px 40px; position: relative; overflow: hidden; }
  .article-header::after { content: '\01F4F0'; position: absolute; font-size: clamp(15rem, 30vw, 35rem); right: -3%; top: -15%; opacity: 0.06; line-height: 1; pointer-events: none; }
  .back-link { display:inline-block; font-size:13px; font-weight:500; color:rgba(0,43,127,0.6); margin-bottom:1rem; transition:all .2s; position:relative; z-index:2; }
  .back-link:hover { color:#002B7F; }
  .article-meta { display:flex; gap:12px; align-items:center; margin-bottom:1rem; position:relative; z-index:2; }
  .article-tag { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#002B7F; background:rgba(0,43,127,.08); padding:4px 12px; border-radius:100px; }
  .article-date { font-size:13px; color:rgba(0,43,127,.5); }
  .article-header h1 { font-family:'Space Grotesk',sans-serif; font-size:clamp(2rem,4vw,3rem); font-weight:700; color:#002B7F; line-height:1.05; margin-bottom:1rem; position:relative; z-index:2; }
  .article-summary { font-size:clamp(0.95rem,1.3vw,1.05rem); color:rgba(0,43,127,.65); max-width:600px; position:relative; z-index:2; }
  .article-content { padding:48px; }
  .article-body { max-width:720px; margin:0 auto; }
  .article-body p, .article-body li { font-size:15px; line-height:1.8; color:#475569; margin-bottom:1rem; }
  .article-body .info-box { background:#fff; border:2px solid #1a1a2e; padding:24px; margin:1.5rem 0; box-shadow:4px 4px 0 #1a1a2e; }
  .article-body .info-box h4 { font-family:'Space Grotesk',sans-serif; font-weight:700; color:#002B7F; margin-bottom:.5rem; }
  .related-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; margin-top:1rem; }
  .related-grid a { padding:14px 16px; border:2px solid #1a1a2e; background:#fff; box-shadow:4px 4px 0 #1a1a2e; font-weight:700; color:#002B7F; }
  @media (max-width: 768px) { .article-header { padding:40px 24px 30px; } .article-content { padding:32px 24px; } .related-grid { grid-template-columns:1fr; } }
</style>
