---
import SubpageLayout from '../../../../layouts/SubpageLayout.astro';
---

<SubpageLayout title="Immigration & Entry" description="Entry planning, document checks and the steps to take before travel." sectionEmoji="✈️" sectionLabel="Ekauwe" includeTopBar={true} includeFooter={true} locale="na">
  <p>Use this page when you are preparing to enter Nauru or checking the documents you need before travel.</p>
<h2>Checklist</h2>
<ul>
  <li>Check passport validity.</li>
  <li>Confirm the current entry requirement for your nationality.</li>
  <li>Apply with enough lead time.</li>
  <li>Keep onward travel and accommodation proof ready.</li>
</ul>
<div class="callout-grid">
  <div class="callout"><h3>Prepare early</h3><p>Entry rules can take time to process.</p></div>
  <div class="callout"><h3>Verify rules</h3><p>Do not rely on old assumptions.</p></div>
  <div class="callout"><h3>Save copies</h3><p>Keep digital and printed documents.</p></div>
  <div class="callout"><h3>Use the directory</h3><p>Find the right office or contact.</p></div>
</div>
<div class="utility-grid">
  <a href="/na/visit/visa/"><h3>Visit visa</h3><p>Travel-specific entry guidance.</p></a>
  <a href="/na/directory/"><h3>Directory</h3><p>Contacts and offices.</p></a>
  <a href="/na/contact/"><h3>Contact</h3><p>Ask the site team.</p></a>
  <a href="/na/news/"><h3>Updates</h3><p>Watch for changes.</p></a>
</div>
</SubpageLayout>

<style>
  .utility-grid,.link-grid,.callout-grid,.contact-grid{display:grid;gap:16px;margin:1rem 0 2rem}
  .utility-grid,.link-grid,.callout-grid,.contact-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .utility-card,.callout,.contact-card,.link-grid a{border:2px solid #1a1a2e;background:#fff;padding:18px;box-shadow:4px 4px 0 #1a1a2e;display:block}
  .utility-card h3,.callout h3,.contact-card h4{margin:0 0 8px;font-family:'Space Grotesk',sans-serif;color:#002B7F}
  
  @media (max-width: 720px){.utility-grid,.link-grid,.callout-grid,.contact-grid{grid-template-columns:1fr}}
</style>
