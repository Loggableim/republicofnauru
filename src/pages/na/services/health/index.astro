---
import SubpageLayout from '../../../../layouts/SubpageLayout.astro';
---

<SubpageLayout title="Healthcare" description="Public health services, emergency contacts and medical planning." sectionEmoji="🏥" sectionLabel="Ekauwe" includeTopBar={true} includeFooter={true} locale="na">
  <p>Use this page when you need to know how health services are organised or what to do in an urgent medical situation.</p>
<h2>Checklist</h2>
<ul>
  <li>Save emergency numbers before you travel.</li>
  <li>Bring any regular medications you need.</li>
  <li>Know where the hospital is and how to contact it.</li>
  <li>Use the directory if you need a different office.</li>
</ul>
<div class="info-box"><h4>Emergency numbers</h4><p>Police 110 · Fire 111 · Ambulance 112</p></div>
<div class="utility-grid">
  <a href="/na/directory/"><h3>Directory</h3><p>Hospital and office contacts.</p></a>
  <a href="/na/visit/communications/"><h3>Communications</h3><p>Stay reachable if needed.</p></a>
  <a href="/na/services/"><h3>Services hub</h3><p>Other citizen help pages.</p></a>
  <a href="/na/news/press-budget/"><h3>Public services</h3><p>Budget and service context.</p></a>
</div>
</SubpageLayout>

<style>
  .utility-grid,.link-grid,.callout-grid,.contact-grid{display:grid;gap:16px;margin:1rem 0 2rem}
  .utility-grid,.link-grid,.callout-grid,.contact-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .utility-card,.callout,.contact-card,.link-grid a{border:2px solid #1a1a2e;background:#fff;padding:18px;box-shadow:4px 4px 0 #1a1a2e;display:block}
  .utility-card h3,.callout h3,.contact-card h4{margin:0 0 8px;font-family:'Space Grotesk',sans-serif;color:#002B7F}
  
  @media (max-width: 720px){.utility-grid,.link-grid,.callout-grid,.contact-grid{grid-template-columns:1fr}}
</style>
