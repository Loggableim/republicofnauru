  .utility-card h3, .callout h3, .contact-card h4 {
    margin: 0 0 8px;
    font-family: 'Space Grotesk', sans-serif;
    color: #1a1a2e;
    font-size: 16px;
  }
  .utility-card p, .callout p { margin: 0; font-size: 13px; color: #64748b; line-height: 1.6; }
  @media (max-width: 720px) { .utility-grid, .link-grid, .callout-grid, .contact-grid { grid-template-columns: 1fr; } }
