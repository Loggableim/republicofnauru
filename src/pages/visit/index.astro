  .callout h3{margin:0 0 6px;font-family:'Space Grotesk',sans-serif;color:#002B7F}
  table{width:100%;border-collapse:collapse;margin:1.5rem 0;background:#fff;border:1px solid #e2e8f0;border-radius:8px}
