---
import SubpageLayout from '../../layouts/SubpageLayout.astro';
import attireData from '../../data/attire.json';
---

<SubpageLayout title={attireData.title} description={attireData.subtitle} sectionEmoji="👔" sectionLabel="Dress Code" includeTopBar={true} includeFooter={true}>
  <p>{attireData.intro}</p>
  {attireData.sections.map(s => (<><h2>{s.heading}</h2>{s.content.split('\n\n').map(p => p.trim() ? <p>{p}</p> : null)}</>))}
</SubpageLayout>
