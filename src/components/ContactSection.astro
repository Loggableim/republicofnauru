---
import contactData from '../data/contact.json';
---

<section class="section bg-cream">
  <div class="section-inner" style="max-width:900px;">
    <div class="section-tag">✉️ Contact</div>
    <div class="section-header">
      <h2>Get in Touch</h2>
      <p>Reach out for travel inquiries, general information, or assistance.</p>
    </div>
    <div class="contact-panel">
      <div>
        <h3>Contact Information</h3>
        <div class="info-line">{contactData.address}</div>
        <div class="info-line">{contactData.phone}</div>
        <div class="info-line">{contactData.email}</div>
        <div class="info-line">{contactData.hours}</div>
        <div class="emergency">
          <p>{contactData.emergency}</p>
        </div>
      </div>
      <form>
        <h3>Send a Message</h3>
        <input type="text" placeholder="Your Name" disabled />
        <input type="email" placeholder="Your Email" disabled />
        <textarea placeholder="Your Message" disabled></textarea>
        <button type="button">Submit Inquiry →</button>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-panel {
    background: #fff; border: 2px solid #1a1a2e;
    padding: 40px;
    display: grid; grid-template-columns: 1fr 1fr; gap: 40px;
    box-shadow: 6px 6px 0 #1a1a2e;
  }
  .contact-panel h3 { font-size: 18px; font-weight: 700; color: #1a1a2e; margin-bottom: 1rem; }
  .contact-panel .info-line { font-size: 14px; color: #475569; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 8px; }
  .contact-panel .emergency {
    margin-top: 1.5rem; background: #FFC72C; padding: 16px;
    border: 2px solid #1a1a2e; clip-path: polygon(8px 0%,100% 0%,calc(100% - 8px) 100%,0% 100%);
  }
  .contact-panel .emergency p { font-size: 13px; font-weight: 600; color: #002B7F; }
  .contact-panel form { display: flex; flex-direction: column; gap: 12px; }
  .contact-panel input, .contact-panel textarea {
    border: 2px solid #1a1a2e; padding: 12px 16px;
    font-family: 'Inter', sans-serif; font-size: 14px; outline: none; transition: border-color .25s;
  }
  .contact-panel input:focus, .contact-panel textarea:focus { border-color: #FFC72C; }
  .contact-panel textarea { min-height: 100px; resize: vertical; }
  .contact-panel button {
    background: #002B7F; color: #FFC72C; border: none;
    padding: 14px 28px; font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: 15px; cursor: pointer;
    clip-path: polygon(8px 0%,100% 0%,calc(100% - 8px) 100%,0% 100%);
    transition: all .25s;
  }
  .contact-panel button:hover { transform: translateX(4px); }
  @media (max-width: 768px) {
    .contact-panel { grid-template-columns: 1fr; padding: 24px; gap: 24px; }
    .contact-panel .info-line { font-size: 13px; }
    .contact-panel .emergency { clip-path: none; border-radius: 8px; }
    .contact-panel button { width: 100%; justify-content: center; }
  }
</style>
