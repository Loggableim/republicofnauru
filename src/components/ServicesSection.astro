---
export interface Props {
  items: { icon: string; title: string; desc: string; href?: string }[];
}

const { items } = Astro.props;
---

<section class="section bg-cream">
  <div class="section-inner">
    <div class="section-tag">🛠️ Services</div>
    <div class="section-header">
      <h2>Citizen & Visitor Services</h2>
      <p>Quick access to the most commonly requested services and information.</p>
    </div>
    <div class="services-grid">
      {items.map(service => {
        const hasHref = service.href && service.href !== '#';
        const Tag = hasHref ? 'a' : 'div';
        const linkAttrs = hasHref ? { href: service.href } : {};
        return (
          <Tag class="service-card" {...linkAttrs} aria-label={hasHref ? `Open service: ${service.title}` : undefined}>
            <div class="icon">{service.icon}</div>
            <h3>{service.title}</h3>
            <p>{service.desc}</p>
            {!hasHref && <span class="coming-soon">Coming soon</span>}
          </Tag>
        );
      })}
    </div>
  </div>
</section>

<style>
  .services-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;
  }
  .service-card {
    background: #fff; border: 2px solid #1a1a2e;
    padding: 28px 20px; text-align: center;
    transition: all .3s; display: block; text-decoration: none;
  }
  .service-card:hover { border-color: #FFC72C; background: #FFC72C; transform: translate(-2px,-2px); box-shadow: 4px 4px 0 #1a1a2e; }
  .service-card .icon { font-size: 2rem; margin-bottom: 0.75rem; }
  .service-card h3 { font-size: 14px; font-weight: 700; color: #1a1a2e; }
  .service-card p { font-size: 12px; color: #64748b; margin-top: 4px; }
  .coming-soon { display: inline-block; font-size: 9px; font-weight: 700; text-transform: uppercase; color:#94a3b8; background:#f1f5f9; padding:2px 8px; border-radius:4px; margin-top:8px; }
  @media (max-width: 768px) {
    .services-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
