---
export interface Props {
  items: { icon: string; title: string; desc: string; extendedDesc?: string }[];
}

const { items } = Astro.props;
const primary = items[0];
const rest = items.slice(1);
const hasExtended = !!primary?.extendedDesc;
---

<section class="section bg-cream">
  <div class="section-inner">
    <div class="section-tag">✨ Discover Nauru</div>
    <div class="section-header">
      <h2>Explore the island</h2>
      <p>From pristine beaches to rich cultural traditions — dive into everything Nauru has to offer.</p>
    </div>
    <div class="features-grid">
      <!-- Karte 1 — groß, Navy, 2 Zeilen hoch, extended content -->
      <div class="feature-card card-primary">
        <div class="card-icon">{primary.icon}</div>
        <h3>{primary.title}</h3>
        <p>{primary.desc}</p>
        {hasExtended && <p class="card-extended">{primary.extendedDesc}</p>}
      </div>

      <!-- Karte 2 — White mit Border+shadow -->
      <div class="feature-card card-white-border">
        <div class="card-icon">{rest[0].icon}</div>
        <h3>{rest[0].title}</h3>
        <p>{rest[0].desc}</p>
      </div>

      <!-- Karte 3 — Yellow -->
      <div class="feature-card card-yellow">
        <div class="card-icon">{rest[1].icon}</div>
        <h3>{rest[1].title}</h3>
        <p>{rest[1].desc}</p>
      </div>

      <!-- Karte 4 — White, 2 Spalten breit -->
      <div class="feature-card card-white-wide">
        <div class="card-icon">{rest[2].icon}</div>
        <h3>{rest[2].title}</h3>
        <p>{rest[2].desc}</p>
      </div>

      <!-- Karte 5 — Navy -->
      <div class="feature-card card-navy">
        <div class="card-icon">{rest[3].icon}</div>
        <h3>{rest[3].title}</h3>
        <p>{rest[3].desc}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .features-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    grid-auto-rows: auto;
    gap: 16px;
  }

  /* Karte 1 — groß, Navy, 2 Zeilen hoch */
  .card-primary {
    grid-row: span 2;
    background: #002B7F;
    color: #fff;
    border: 2px solid #002B7F;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .card-primary .card-icon { font-size: 2.4rem; margin-bottom: 0.75rem; }
  .card-primary h3 { font-size: 1.4rem; font-weight: 700; margin: 0 0 8px; color: #fff; }
  .card-primary p { font-size: 13px; color: rgba(255,255,255,0.85); line-height: 1.6; margin: 0; }
  .card-primary .card-extended {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid rgba(255,255,255,0.25);
    font-size: 12px;
    color: rgba(255,255,255,0.7);
  }

  /* Karte 2 — White mit Border + shadow */
  .card-white-border {
    background: #fff;
    border: 2px solid #1a1a2e;
    box-shadow: 4px 4px 0 #1a1a2e;
    padding: 28px 20px;
  }
  .card-white-border .card-icon { font-size: 2rem; margin-bottom: 0.75rem; }
  .card-white-border h3 { font-size: 14px; font-weight: 700; color: #1a1a2e; margin: 0 0 6px; }
  .card-white-border p { font-size: 12px; color: #64748b; line-height: 1.6; margin: 0; }

  /* Karte 3 — Yellow */
  .card-yellow {
    background: #FFC72C;
    border: 2px solid #1a1a2e;
    padding: 28px 20px;
  }
  .card-yellow .card-icon { font-size: 2rem; margin-bottom: 0.75rem; }
  .card-yellow h3 { font-size: 14px; font-weight: 700; color: #1a1a2e; margin: 0 0 6px; }
  .card-yellow p { font-size: 12px; color: #1a1a2e; line-height: 1.6; margin: 0; }

  /* Karte 4 — White, 2 Spalten breit */
  .card-white-wide {
    grid-column: span 2;
    background: #fff;
    border: 2px solid #1a1a2e;
    padding: 28px 20px;
  }
  .card-white-wide .card-icon { font-size: 2rem; margin-bottom: 0.75rem; }
  .card-white-wide h3 { font-size: 14px; font-weight: 700; color: #1a1a2e; margin: 0 0 6px; }
  .card-white-wide p { font-size: 12px; color: #64748b; line-height: 1.6; margin: 0; }

  /* Karte 5 — Navy */
  .card-navy {
    background: #002B7F;
    color: #fff;
    border: 2px solid #002B7F;
    padding: 28px 20px;
  }
  .card-navy .card-icon { font-size: 2rem; margin-bottom: 0.75rem; }
  .card-navy h3 { font-size: 14px; font-weight: 700; color: #fff; margin: 0 0 6px; }
  .card-navy p { font-size: 12px; color: rgba(255,255,255,0.85); line-height: 1.6; margin: 0; }

  @media (max-width: 900px) {
    .features-grid {
      grid-template-columns: 1fr 1fr;
    }
    .card-primary { grid-row: auto; }
    .card-white-wide { grid-column: span 2; }
  }

  @media (max-width: 640px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
    .card-white-wide { grid-column: auto; }
  }
</style>