---
export interface Props {
  locale?: 'en' | 'na';
  links?: { label: string; url: string }[];
}

const { locale = 'en' } = Astro.props as Props;

const defaultLinks = locale === 'na'
  ? [
      { label: 'Edorer', url: '/na/news/' },
      { label: 'Ekauwe', url: '/na/services/' },
      { label: 'Etimine', url: '/na/about/' },
      { label: 'Tebor', url: '/na/directory/' },
      { label: 'Kanek', url: '/na/search/' },
    ]
  : [
      { label: 'Visit', url: '/visit/' },
      { label: 'About', url: '/about/' },
      { label: 'Services', url: '/services/' },
      { label: 'News', url: '/news/' },
      { label: 'Directory', url: '/directory/' },
      { label: 'Search', url: '/search/' },
    ];

const { links = defaultLinks } = Astro.props as Props;
const homeHref = locale === 'na' ? '/na/' : '/';
const logoSpan = locale === 'na' ? 'Naoero' : 'Nauru';
---

<div class="navbar">
  <div class="nav-inner">
    <a href={homeHref} class="nav-logo">
      <span class="flag-icon"></span>
      <span class="logo-text">Rep. of {logoSpan}</span>
    </a>
    <nav class="nav-links">
      {links.map(link => (
        <a href={link.url}>{link.label}</a>
      ))}
      <div class="lang-switch">
        <a href="/" class:list={{ 'lang-active': locale === 'en' }}>EN</a>
        <a href="/na/" class:list={{ 'lang-active': locale === 'na' }}>NA</a>
      </div>
    </nav>
  </div>
</div>

<style is:global>
  .navbar {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(255,255,255,0.97);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid #e2e8f0;
  }
  .nav-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 64px;
    padding: 0 48px;
  }
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .flag-icon {
    width: 28px;
    height: 18px;
    border-radius: 2px;
    background: linear-gradient(180deg, #002B7F 33%, #FFC72C 33% 66%, #002B7F 66%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    flex-shrink: 0;
  }
  .flag-icon::after {
    content: '★';
    color: #fff;
    font-size: 8px;
  }
  .logo-text {
    font-weight: 700;
    font-size: 16px;
    color: #1a1a2e;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .nav-links a {
    font-size: 13px;
    font-weight: 500;
    color: #475569;
    text-decoration: none;
    padding: 6px 0;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .nav-links a:hover {
    color: #002B7F;
  }
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 4px;
    padding-left: 20px;
    border-left: 1px solid #e2e8f0;
  }
  .lang-switch a {
    font-weight: 600 !important;
    font-size: 12px !important;
    padding: 4px 10px !important;
    border-radius: 6px;
    transition: all 0.2s;
  }
  .lang-switch a:hover {
    background: #eef2ff;
  }
  .lang-active {
    background: #002B7F !important;
    color: #fff !important;
  }
  .lang-active:hover {
    background: #001f5c !important;
  }

  @media (max-width: 768px) {
    .nav-inner { padding: 0 20px; }
    .logo-text { display: none; }
    .nav-links { gap: 14px; }
    .nav-links a { font-size: 12px; }
    .lang-switch { padding-left: 12px; }
  }
</style>
