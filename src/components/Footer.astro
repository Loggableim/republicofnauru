---
import footerData from '../data/footer.json';
---

<footer>
  <div class="footer-inner">
    {footerData.footerColumns.map(col => (
      <div>
        <h4>{col.title}</h4>
        {col.text && <p>{col.text}</p>}
        {col.links && col.links.map(link => (
          <a href={link.url}>{link.label}</a>
        ))}
        {col.title === 'Republic of Nauru' && (
          <div class="social">
            {footerData.social.map(icon => (
              <span class="social-icon" aria-hidden="true">{icon}</span>
            ))}
          </div>
        )}
      </div>
    ))}
  </div>
  <div class="copyright">{footerData.copyright} | <a href="https://nauru.gov.nr" target="_blank">Official Government Site →</a></div>
  <div class="disclaimer">{footerData.disclaimer}</div>
</footer>

<style>
  footer {
    background: #1a1a2e; color: rgba(255,255,255,.4);
    padding: 48px 48px;
  }
  footer .footer-inner {
    max-width: 1280px; margin: 0 auto;
    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px;
  }
  footer h4 {
    font-size: 13px; font-weight: 700; color: #FFC72C;
    margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 1px;
    font-family: 'Space Grotesk', sans-serif;
  }
  footer a { display: block; font-size: 13px; color: rgba(255,255,255,.4); margin-bottom: 0.5rem; }
  footer a:hover { color: #FFC72C; }
  footer p { font-size: 13px; }
  footer .social { display: flex; gap: 12px; margin-top: 1rem; }
  footer .social .social-icon {
    width: 36px; height: 36px; border-radius: 50%;
    background: rgba(255,255,255,.06);
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 1.1rem;
  }
  footer .social .social-icon:hover { background: #FFC72C; color: #1a1a2e; }
  footer .copyright {
    max-width: 1280px; margin: 2rem auto 0; padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,.06);
    font-size: 12px; text-align: center;
  }
  footer .copyright a { display: inline; color: #FFC72C; }
  footer .copyright a:hover { text-decoration: underline; }
  footer .disclaimer {
    max-width: 1280px; margin: 0.5rem auto 0;
    font-size: 11px; text-align: center; color: rgba(255,255,255,.25);
  }
  @media (max-width: 768px) {
    footer .footer-inner { grid-template-columns: 1fr 1fr; }
    footer { padding: 32px 24px; }
  }
</style>

