---
export interface Props {
  stats: { num: string; label: string }[];
}

const { stats } = Astro.props;
---

<section class="section bg-cream no-top-padding no-bottom-padding">
  <div class="section-inner">
    <div class="stats-strip">
      {stats.map(stat => (
        <div class="stat-item">
          <div class="num">{stat.num}</div>
          <div class="label">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .stats-strip {
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 0;
    border: 2px solid #1a1a2e; background: #fff;
  }
  .stat-item {
    padding: 32px 24px; text-align: center;
    border-right: 1px solid #1a1a2e;
  }
  .stat-item:last-child { border-right: none; }
  .stat-item .num {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2.2rem; font-weight: 700; color: #002B7F;
  }
  .stat-item .label { font-size: 11px; color: #1a1a2e; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; margin-top: 4px; }
  @media (max-width: 768px) {
    .stats-strip { grid-template-columns: repeat(3, 1fr); }
    .stat-item { padding: 20px 12px; }
    .stat-item:nth-child(4),
    .stat-item:nth-child(5) { border-top: 1px solid #1a1a2e; }
    .stat-item:nth-child(3) { border-right: none; }
    .stat-item .num { font-size: 1.6rem; }
    .stat-item .label { font-size: 10px; }
  }
  @media (max-width: 480px) {
    .stats-strip { grid-template-columns: repeat(2, 1fr); }
    .stat-item:nth-child(3) { border-right: 1px solid #1a1a2e; }
    .stat-item:nth-child(5) { grid-column: span 2; border-right: none; }
    .stat-item:nth-child(2) { border-right: none; }
  }
</style>
