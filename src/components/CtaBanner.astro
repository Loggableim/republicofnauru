<style>
  .cta-banner {
    background: #FFC72C; padding: 80px 48px; text-align: center;
    border-top: 2px solid #1a1a2e;
    border-bottom: 2px solid #1a1a2e;
  }
  .cta-banner h2 {
    font-size: clamp(3rem, 6vw, 5rem);
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; color: #002B7F; line-height: 1.05;
    margin-bottom: 1.5rem;
  }
  .cta-banner p { color: rgba(0,43,127,0.6); font-size: 14px; margin-top: 1.5rem; }

  .hero-cta {
    display: inline-flex; align-items: center; gap: 12px;
    background: #002B7F; color: #FFC72C;
    padding: 18px 40px; border-radius: 0;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: 16px;
    clip-path: polygon(12px 0%, 100% 0%, calc(100% - 12px) 100%, 0% 100%);
    transition: all .3s;
  }
  .hero-cta:hover { transform: translateX(4px); }

  @media (max-width: 768px) {
    .cta-banner { padding: 48px 24px; }
  }
</style>

