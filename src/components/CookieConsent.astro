---
---

<div id="cookie-banner" class="cookie-banner" role="dialog" aria-label="Cookie consent">
  <div class="cookie-text">
    <p>We use cookies and similar technologies to improve your browsing experience, serve personalised ads, and analyse site traffic. You can choose which categories to allow.</p>
  </div>
  <div class="cookie-buttons">
    <button id="cookie-accept" class="cookie-btn cookie-accept">Accept All</button>
    <button id="cookie-settings" class="cookie-btn cookie-settings">Settings</button>
    <button id="cookie-reject" class="cookie-btn cookie-reject">Reject All</button>
  </div>
</div>

<div id="cookie-settings-panel" class="cookie-settings" hidden>
  <div class="cookie-settings-inner">
    <h3>Cookie Settings</h3>
    <p>Customise which cookies you allow on this site.</p>
    <label class="cookie-toggle">
      <span><strong>Essential</strong> — Required for the site to function (language preference, cookie consent). Cannot be disabled.</span>
      <input type="checkbox" checked disabled />
    </label>
    <label class="cookie-toggle">
      <span><strong>Advertising</strong> — Google AdSense uses cookies to serve relevant ads. <a href="https://policies.google.com/technologies/ads" target="_blank" rel="noopener">Learn more</a></span>
      <input type="checkbox" id="cookie-ads-consent" checked />
    </label>
    <label class="cookie-toggle">
      <span><strong>Analytics</strong> — Understand how visitors interact with the site (aggregated, anonymised).</span>
      <input type="checkbox" id="cookie-analytics-consent" />
    </label>
    <div class="cookie-settings-buttons">
      <button id="cookie-save-settings" class="cookie-btn cookie-accept">Save Preferences</button>
      <button id="cookie-close-settings" class="cookie-btn cookie-reject">Cancel</button>
    </div>
  </div>
</div>

<script>
(function() {
  const CONSENT_KEY = 'nauru-cookie-consent';
  const consent = JSON.parse(localStorage.getItem(CONSENT_KEY) || 'null');

  // If consent already given, load ad/analytics scripts
  if (consent) {
    if (consent.ads && typeof adsbygoogle === 'undefined') {
      // AdSense already loaded via <head> — we can't unload it, but we can set page-level ad config
      window.adsbygoogle = window.adsbygoogle || [];
      window.adsbygoogle.requestNonPersonalizedAds = consent.personalized ? 0 : 1;
    }
    return;
  }

  // Show banner
  var banner = document.getElementById('cookie-banner');
  if (banner) banner.classList.add('visible');

  var settingsPanel = document.getElementById('cookie-settings-panel');

  function saveConsent(options) {
    var data = {
      essential: true,
      ads: options.ads || false,
      analytics: options.analytics || false,
      personalized: options.personalized !== false,
      savedAt: new Date().toISOString(),
    };
    localStorage.setItem(CONSENT_KEY, JSON.stringify(data));
    if (banner) banner.classList.remove('visible');
    if (settingsPanel) settingsPanel.hidden = true;
    // Reload to activate ad config
    if (data.ads) {
      // Re-init AdSense with consent
      window.adsbygoogle = window.adsbygoogle || [];
      window.adsbygoogle.requestNonPersonalizedAds = data.personalized ? 0 : 1;
    }
  }

  document.getElementById('cookie-accept')?.addEventListener('click', function() {
    saveConsent({ ads: true, analytics: true, personalized: true });
  });

  document.getElementById('cookie-reject')?.addEventListener('click', function() {
    saveConsent({ ads: false, analytics: false });
  });

  document.getElementById('cookie-settings')?.addEventListener('click', function() {
    if (settingsPanel) settingsPanel.hidden = false;
  });

  document.getElementById('cookie-close-settings')?.addEventListener('click', function() {
    if (settingsPanel) settingsPanel.hidden = true;
  });

  document.getElementById('cookie-save-settings')?.addEventListener('click', function() {
    var adsChecked = document.getElementById('cookie-ads-consent')?.checked || false;
    var analyticsChecked = document.getElementById('cookie-analytics-consent')?.checked || false;
    saveConsent({ ads: adsChecked, analytics: analyticsChecked, personalized: adsChecked });
  });
})();
</script>

<style>
  .cookie-banner {
    position: fixed; bottom: 0; left: 0; right: 0;
    background: #002B7F; color: #fff;
    padding: 20px 32px;
    z-index: 300;
    transform: translateY(100%);
    transition: transform .4s ease;
    font-size: 14px;
    box-shadow: 0 -4px 20px rgba(0,0,0,0.15);
  }
  .cookie-banner.visible { transform: translateY(0); }
  .cookie-text { max-width: 700px; margin-bottom: 14px; }
  .cookie-text p { margin: 0; font-size: 13px; line-height: 1.6; color: rgba(255,255,255,0.9); }
  .cookie-buttons { display: flex; gap: 8px; flex-wrap: wrap; }
  .cookie-btn {
    padding: 10px 22px; border: none; border-radius: 6px;
    font-size: 13px; font-weight: 600; cursor: pointer;
    transition: all .2s; font-family: 'Space Grotesk', sans-serif;
  }
  .cookie-btn:hover { opacity: .85; transform: translateY(-1px); }
  .cookie-accept { background: #FFC72C; color: #002B7F; }
  .cookie-settings { background: rgba(255,255,255,.12); color: #fff; border: 1px solid rgba(255,255,255,.25) !important; }
  .cookie-reject { background: transparent; color: rgba(255,255,255,.7); border: 1px solid rgba(255,255,255,.15) !important; }
  .cookie-reject:hover { background: rgba(255,255,255,.08); }

  /* Settings panel */
  .cookie-settings {
    position: fixed; bottom: 0; left: 0; right: 0; top: 0;
    background: rgba(0,0,0,0.5);
    display: flex; align-items: center; justify-content: center;
    z-index: 400;
  }
  .cookie-settings:not([hidden]) { display: flex; }
  .cookie-settings-inner {
    background: #fff; color: #1a1a2e;
    max-width: 520px; width: 90%; padding: 32px;
    border-radius: 12px; box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  }
  .cookie-settings-inner h3 { font-family: 'Space Grotesk', sans-serif; font-size: 1.3rem; margin-bottom: 8px; }
  .cookie-settings-inner > p { font-size: 13px; color: #64748b; margin-bottom: 20px; }
  .cookie-toggle {
    display: flex; align-items: flex-start; gap: 12px;
    padding: 14px 0; border-top: 1px solid #e2e8f0;
    cursor: pointer;
  }
  .cookie-toggle span { font-size: 13px; line-height: 1.6; color: #475569; flex: 1; }
  .cookie-toggle span strong { color: #1a1a2e; }
  .cookie-toggle span a { color: #002B7F; text-decoration: underline; }
  .cookie-toggle input[type="checkbox"] {
    width: 18px; height: 18px; margin-top: 2px; flex-shrink: 0;
    accent-color: #002B7F;
  }
  .cookie-settings-buttons { display: flex; gap: 8px; margin-top: 20px; padding-top: 16px; border-top: 1px solid #e2e8f0; }

  @media (max-width: 768px) {
    .cookie-banner { padding: 16px 20px; }
    .cookie-btn { font-size: 12px; padding: 8px 16px; }
  }
</style>
