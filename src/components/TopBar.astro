---
export interface Props {
  locale?: string;
  accessibility?: boolean;
  timezone?: string;
}
const { locale = 'en', accessibility = true, timezone = 'UTC+12' } = Astro.props;
---

<div class="topbar">
  <div class="topbar-inner">
    <span>Republic of Nauru — Visitor Information</span>
    <nav class="topbar-links" aria-label="Utility links">
      <a href="/about/">About</a>
      <a href="/visit/">Visit</a>
      <a href="/contact/">Contact</a>
      <span class="divider">|</span>
      <span class="lang-active" aria-current="true">EN</span>
      <span class="lang-inactive" title="Nauruan translation in progress">NA</span>
    </nav>
  </div>
</div>

<style>
  .topbar {
    background: #002B7F;
    color: #fff;
    padding: 10px 48px;
    font-size: 12px;
    border-bottom: 1px solid rgba(255,255,255,.1);
  }
  .topbar-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .topbar-links {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .topbar a { color: #fff; text-decoration: none; opacity: .85; }
  .topbar a:hover { opacity: 1; text-decoration: underline; }
  .divider { opacity: .5; }
  .lang-active { color: #FFC72C; font-weight: 700; }
  .lang-inactive { opacity: .7; }
  @media (max-width: 768px) {
    .topbar { padding: 10px 20px; }
    .topbar-inner { flex-direction: column; align-items: flex-start; gap: 8px; }
    .topbar-links { flex-wrap: wrap; gap: 10px; }
  }
</style>
