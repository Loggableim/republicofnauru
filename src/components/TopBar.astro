---
interface Props {
  locale?: 'en' | 'na';
}

const { locale = 'en' } = Astro.props as Props;

const nav = {
  about: { en: { label: 'About', href: '/about/' }, na: { label: 'Etimine', href: '/na/about/' } },
  visit: { en: { label: 'Visit', href: '/visit/' }, na: { label: 'Kain ekawir', href: '/na/visit/' } },
  press: { en: { label: 'Press & Announcements', href: '/news/' }, na: { label: 'Edorer Ijino', href: '/na/news/' } },
  contact: { en: { label: 'Contact', href: '/contact/' }, na: { label: 'Kain kõme', href: '/na/contact/' } },
};

const topics = [
  { en: 'Visa', na: 'Visa', href: '/visit/visa/' },
  { en: 'Weather', na: 'Uab', href: '/visit/weather/' },
  { en: 'Budget', na: 'Budjet', href: '/visit/currency/' },
  { en: 'Culture', na: 'Ebõk', href: '/about/culture/' },
  { en: 'News', na: 'Edorer', href: '/news/' },
  { en: 'Services', na: 'Ekauwe', href: '/services/' },
  { en: 'Search', na: 'Kanek', href: '/search/' },
];
---

<div class="topbar">
  <div class="topbar-inner">
    <span>{locale === 'na' ? 'Republik Naoero — Taramit Ñago' : 'Republic of Nauru — Visitor Information'}</span>
    <nav class="topbar-links" aria-label="Utility links">
      <a href={locale === 'na' ? nav.about.na.href : nav.about.en.href}>{nav.about.en.label} · {nav.about.na.label}</a>
      <a href={locale === 'na' ? nav.visit.na.href : nav.visit.en.href}>{nav.visit.en.label} · {nav.visit.na.label}</a>
      <a href={locale === 'na' ? nav.press.na.href : nav.press.en.href}>{nav.press.en.label} · {nav.press.na.label}</a>
      <a href={locale === 'na' ? nav.contact.na.href : nav.contact.en.href}>{nav.contact.en.label} · {nav.contact.na.label}</a>
      <span class="divider">|</span>
      <a href="/" class:list={["lang-link", locale === 'en' && 'lang-active']} aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
      <a href="/na/" class:list={["lang-link", locale === 'na' && 'lang-active']} aria-current={locale === 'na' ? 'page' : undefined}>NA</a>
    </nav>
  </div>
  <div class="topbar-topics" aria-label="Quick topic links">
    {topics.map((topic) => (
      <a href={locale === 'na' ? topic.href.replace(/^\//, '/na/') : topic.href} class="topic-pill">{locale === 'na' ? topic.na : topic.en} →</a>
    ))}
  </div>
</div>

<style>
  .topbar { background:#002B7F; color:#fff; padding:10px 48px; font-size:12px; border-bottom:1px solid rgba(255,255,255,.1); }
  .topbar-inner { max-width:1280px; margin:0 auto; display:flex; justify-content:space-between; align-items:center; gap:16px; }
  .topbar-links { display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  .topbar a { color:#fff; text-decoration:none; opacity:.9; }
  .topbar a:hover { opacity:1; text-decoration:underline; }
  .divider { opacity:.5; }
  .lang-link { font-weight:700; }
  .lang-active { color:#FFC72C; }
  .topbar-topics { max-width:1280px; margin:8px auto 0; display:flex; gap:10px; flex-wrap:wrap; }
  .topic-pill { display:inline-flex; align-items:center; padding:6px 10px; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.2); border-radius:999px; font-size:11px; font-weight:700; }
  @media (max-width: 768px) {
    .topbar { padding:10px 20px; }
    .topbar-inner { flex-direction:column; align-items:flex-start; gap:8px; }
    .topbar-topics { margin-top:10px; }
  }
</style>
