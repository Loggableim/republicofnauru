---
import siteData from '../data/site.json';

const { heroHeadline, heroHeadlineOutline, heroSubtext, heroCta, heroEyebrow, heroFacts } = siteData;
const isLuxury = false;
const heroFontClass = 'space-grotesk';
const heroBgClass = '';
const showParticles = false;
---

<section class={`hero ${heroFontClass} ${heroBgClass}`}>
  <div class="hero-bg">
    <img src="/hero-nauru.webp" alt="Aerial view of Nauru island" loading="eager" decoding="async" />
  </div>
  <div class="hero-top">
    <div class="hero-text">
      <div class="eyebrow">{heroEyebrow}</div>
      <h1>
        {heroHeadline.map((line, i) => (
          i === heroHeadlineOutline
            ? <span class="outline">{line}<br/></span>
            : <>{line}<br/></>
        ))}
      </h1>
      <p>{heroSubtext}</p>
      <a href="/about/" class="hero-cta">{heroCta}</a>
    </div>
  </div>
  <div class="hero-bottom">
    {heroFacts.map(fact => (
      <div class="hb-item">{fact.icon} {fact.text}</div>
    ))}
  </div>
  {showParticles && <div class="gold-particles" aria-hidden="true"><span></span><span></span><span></span></div>}
</section>

<style>
  /* ===== HERO ===== */
  .hero {
    min-height: 100vh;
    display: flex; flex-direction: column;
    position: relative; overflow: hidden;
  }
  .hero-bg {
    position: absolute; inset: 0;
    z-index: 0;
  }
  .hero-bg img {
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .hero-bg::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(0,43,127,0.55) 0%, rgba(0,20,60,0.35) 100%);
  }
  .hero::after {
    content: '🇳🇷';
    position: absolute; font-size: clamp(20rem, 40vw, 50rem);
    right: -5%; top: -10%; opacity: 0.06; line-height: 1;
    pointer-events: none; z-index: 1;
  }
  .hero-top, .hero-bottom { position: relative; z-index: 2; }
  .hero-top {
    flex: 1; display: flex; align-items: center;
    padding: 140px 48px 0;
  }
  .hero-text { max-width: 780px; position: relative; z-index: 2; }
  .hero-text .eyebrow {
    display: inline-block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 12px; font-weight: 600; text-transform: uppercase;
    letter-spacing: 4px; color: #002B7F; margin-bottom: 1.5rem;
    border: 2px solid #002B7F; padding: 6px 16px; border-radius: 100px;
  }
  .hero-text h1 {
    font-size: clamp(3.5rem, 10vw, 7rem);
    line-height: 0.95; color: #002B7F;
    margin-bottom: 1.5rem;
  }
  .hero-text .outline {
    color: transparent;
    -webkit-text-stroke: 2px #002B7F;
    paint-order: stroke fill;
  }
  .hero-text p {
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    color: rgba(0,43,127,0.7); font-weight: 400;
    max-width: 520px; margin-bottom: 2rem;
    line-height: 1.7;
  }
  .hero-cta {
    display: inline-flex; align-items: center; gap: 12px;
    background: #002B7F; color: #FFC72C;
    padding: 18px 40px; border-radius: 0;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700; font-size: 16px;
    clip-path: polygon(12px 0%, 100% 0%, calc(100% - 12px) 100%, 0% 100%);
    transition: all .3s;
  }
  .hero-cta:hover { transform: translateX(4px); }
  .hero-bottom {
    padding: 24px 48px;
    display: flex; gap: 48px; align-items: center;
    border-top: 1px solid rgba(0,43,127,0.1);
    flex-wrap: wrap;
  }
  .hero-bottom .hb-item {
    display: flex; align-items: center; gap: 8px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px; font-weight: 600; color: #002B7F;
  }

  /* ===== MOBILE ===== */
  @media (max-width: 900px) {
    nav { padding: 12px 24px; }
    nav .nav-links a { padding: 6px 10px; font-size: 12px; }
    nav .logo-text { font-size: 16px; }
    .hero-bottom { gap: 24px; }
  }

  @media (max-width: 768px) {
    nav .nav-links { display: none; }
    .hamburger { display: flex; }

    .hero-top { padding: 80px 24px 0; }
    .hero-text h1 { font-size: clamp(2.8rem, 12vw, 4.5rem); }
    .hero-text p { max-width: 100%; }
    .hero-text .eyebrow { font-size: 10px; padding: 4px 12px; }
    .hero-cta {
      padding: 14px 28px; font-size: 14px;
      clip-path: polygon(8px 0%, 100% 0%, calc(100% - 8px) 100%, 0% 100%);
    }
    .hero-bottom { padding: 14px 20px; gap: 10px; }
    .hero-bottom .hb-item { font-size: 11px; }
  }

  @media (max-width: 480px) {
    nav { padding: 10px 16px; }
    .hero-top { padding: 70px 16px 0; }
    .hero-text h1 { font-size: clamp(2.2rem, 14vw, 3.5rem); }
    .hero-bottom { gap: 6px; }
    .hero-bottom .hb-item { font-size: 10px; }
    .hero-cta { padding: 12px 24px; font-size: 13px; width: 100%; justify-content: center; }
  }

  /* ===== LUXURY HERO MODE ===== */
  .hero-luxury {
    background: #0a1628;
  }
  .hero-luxury .hero-bg img {
    opacity: 0.3;
  }
  .hero-luxury .hero-bg::after {
    background: linear-gradient(135deg, rgba(10,22,40,0.85) 0%, rgba(10,22,40,0.5) 100%);
  }
  .hero-luxury::after {
    display: none;
  }
  .hero-luxury .hero-text .eyebrow {
    color: #C9A94E;
    border-color: #C9A94E;
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    letter-spacing: 3px;
  }
  .hero-luxury.playfair .hero-text h1 {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    color: #ffffff;
  }
  .hero-luxury.playfair .hero-text .outline {
    -webkit-text-stroke: 2px #C9A94E;
    color: transparent;
  }
  .hero-luxury .hero-text p {
    color: rgba(255,255,255,0.6);
  }
  .hero-luxury .hero-cta {
    background: #C9A94E;
    color: #0a1628;
    font-family: 'Space Grotesk', sans-serif;
  }
  .hero-luxury .hero-cta:hover {
    background: #dbb856;
  }
  .hero-luxury .hero-bottom {
    border-top-color: rgba(201,169,78,0.2);
  }
  .hero-luxury .hero-bottom .hb-item {
    color: #C9A94E;
  }
  .hero-luxury nav .logo-text {
    color: #ffffff;
  }
  .hero-luxury nav .nav-links a {
    color: rgba(255,255,255,0.7);
  }
  .hero-luxury nav .nav-links a:hover {
    color: #C9A94E;
    background: rgba(201,169,78,0.1);
  }
  .hero-luxury nav .nav-links .btn {
    background: #C9A94E;
    color: #0a1628 !important;
  }
  .hero-luxury nav .nav-links .btn:hover {
    background: #dbb856;
    color: #0a1628 !important;
  }
  .hero-luxury nav .flag-mini {
    background: linear-gradient(180deg, #C9A94E 33%, #0a1628 33% 66%, #C9A94E 66%);
  }
  .hero-luxury .hamburger span {
    background: #ffffff;
  }

  /* Gold particles — CSS-only pseudo-elements */
  .gold-particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }
  .gold-particles span {
    position: absolute;
    display: block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #C9A94E;
    opacity: 0;
    box-shadow: 0 0 6px 2px rgba(201,169,78,0.3);
  }
  .gold-particles span:nth-child(1) {
    left: 10%;
    top: 15%;
    animation: floatGold 6s ease-in-out 0s infinite;
  }
  .gold-particles span:nth-child(2) {
    left: 50%;
    top: 30%;
    width: 6px;
    height: 6px;
    animation: floatGold 8s ease-in-out 1s infinite;
  }
  .gold-particles span:nth-child(3) {
    left: 80%;
    top: 20%;
    width: 3px;
    height: 3px;
    animation: floatGold 7s ease-in-out 2s infinite;
  }
  @keyframes floatGold {
    0% { opacity: 0; transform: translateY(0) scale(0.8); }
    25% { opacity: 0.8; }
    50% { opacity: 1; transform: translateY(-40px) scale(1.2); }
    75% { opacity: 0.6; }
    100% { opacity: 0; transform: translateY(-80px) scale(0.6); }
  }
</style>
